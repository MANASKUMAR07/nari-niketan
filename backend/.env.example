# =============================================
# NARI NIKETAN — Backend Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── NODE ──────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── FIREBASE ADMIN SDK ─────────────────────────
# Obtain from Firebase Console → Project Settings → Service Accounts → Generate new private key
# On Cloud Run, set these as Secret Manager secrets or environment variables.
FIREBASE_PROJECT_ID=nari-niketan
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@nari-niketan.iam.gserviceaccount.com
# The private key must include the full PEM with literal \n for newlines.
# On Cloud Run via Secret Manager the newlines will be real; in .env use \n.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://nari-niketan.web.app,https://nariniketan.shop,https://www.nariniketan.shop

# ── BUSINESS RULES ────────────────────────────
# Free shipping threshold in INR (integer)
FREE_SHIPPING_THRESHOLD=999
# Standard shipping charge in INR (integer)
SHIPPING_CHARGE=99
# Maximum single-order item count (anti-abuse)
MAX_ITEMS_PER_ORDER=20
# Maximum quantity per line item
MAX_QTY_PER_ITEM=10
