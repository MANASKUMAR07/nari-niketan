rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Product images: stored at products/{sellerId}/{productId}/...
    // Supports multi-variant subfolders: /thumbnail/, /medium/, /large/, /original/
    // - Anyone can READ (needed to display images on storefront)
    // - Only the owning seller can WRITE to their own folder
    match /products/{sellerId}/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == sellerId
                   && request.resource.size < 15 * 1024 * 1024   // max 15MB per file
                   && request.resource.contentType.matches('image/.*'); // images only
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
